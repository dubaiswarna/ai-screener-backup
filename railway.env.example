# Railway Environment Variables Template
# Copy these to Railway Dashboard → Your Service → Variables

# ============================================
# BACKEND SERVICE VARIABLES
# ============================================

# Database Configuration (Railway MySQL)
MYSQLHOST=${{MySQL.MYSQLHOST}}
MYSQLPORT=${{MySQL.MYSQLPORT}}
MYSQLUSER=${{MySQL.MYSQLUSER}}
MYSQLPASSWORD=${{MySQL.MYSQLPASSWORD}}
MYSQLDATABASE=${{MySQL.MYSQLDATABASE}}

# Alternative (if Railway variables don't work)
DB_TYPE=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_NAME=${{MySQL.MYSQLDATABASE}}

# Server Configuration
PORT=${{PORT}}
RAILWAY_ENVIRONMENT=production
HOST=0.0.0.0

# Python Configuration
PYTHONUNBUFFERED=1

# ============================================
# FRONTEND SERVICE VARIABLES
# ============================================

# Backend API URL (replace with your backend Railway URL)
NEXT_PUBLIC_API_URL=https://your-backend-service.up.railway.app

# Node Configuration
NODE_ENV=production
PORT=${{PORT}}

# ============================================
# NOTES
# ============================================
# 1. Railway automatically provides PORT variable
# 2. MySQL variables are auto-provided when you add MySQL service
# 3. Replace NEXT_PUBLIC_API_URL with your actual backend URL
# 4. Railway variables use ${{ServiceName.VariableName}} syntax

